<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!-- These report newer releases on the internet, not problems in the code; dependencies are updated on purpose. -->
    <issue id="GradleDependency" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />
    <!-- Only ARM is shipped: the map's native code would add about 10 MB per extra processor type (see build.gradle.kts). -->
    <issue id="ChromeOsAbiSupport" severity="ignore" />
    <!-- The same word in two places ("Now" as a choice and "now" in a sentence, "System" for the theme and the language)
         is two texts: other languages may need different words or grammatical forms for each. -->
    <issue id="DuplicateStrings" severity="ignore" />
</lint>
